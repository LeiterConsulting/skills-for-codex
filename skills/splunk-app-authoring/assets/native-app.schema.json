{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable native Splunk app config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "app_id",
    "app_label",
    "author",
    "version",
    "description",
    "install_state",
    "read_roles",
    "write_roles",
    "dashboard"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,62}$"
    },
    "app_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[+-][A-Za-z0-9]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "install_state": {
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "read_roles": {
      "$ref": "#/$defs/roles"
    },
    "write_roles": {
      "$ref": "#/$defs/roles"
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "query",
        "earliest",
        "latest"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "earliest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "latest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  },
  "$defs": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:\\*|[A-Za-z][A-Za-z0-9_-]{0,63})$"
      }
    }
  }
}
